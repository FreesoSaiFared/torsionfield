{
  "manifest_version": 3,
  "name": "Torsionfield Autogenic Browser Bridge",
  "version": "0.2.0",
  "description": "Persistent Chrome-side bridge from ChatGPT/ScriptCat to the privileged Torsionfield resident.",
  "permissions": ["tabs", "scripting", "storage", "userScripts"],
  "host_permissions": ["http://127.0.0.1:17373/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {"service_worker": "service_worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content_bridge.js"], "run_at": "document_start"}],
  "action": {"default_title": "Torsionfield"}
}
